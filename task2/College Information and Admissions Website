
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex Institute of Technology</title>
    <style>
        /* Base Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            line-height: 1.6;
            background-color: #f4f6f9;
            color: #333;
        }
        
        /* Navigation Bar */
        nav {
            background-color: #002b49;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .logo {
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: bold;
        }
        .nav-links {
            list-style: none;
            display: flex;
            gap: 1.5rem;
        }
        .nav-links a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 500;
        }
        .nav-links a:hover {
            color: #ffc107;
        }

        /* Banner */
        .banner {
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://picsum.photos/1200/400') center/cover;
            color: #ffffff;
            text-align: center;
            padding: 5rem 1rem;
        }
        .banner h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        .banner p {
            font-size: 1.2rem;
        }

        /* Main Container & Sections */
        .container {
            max-width: 1100px;
            margin: 2rem auto;
            padding: 0 1rem;
        }
        section {
            margin-bottom: 3rem;
        }
        h2 {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #002b49;
            border-bottom: 3rem;
        }

