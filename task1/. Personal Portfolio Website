
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Personal Website</title>
    <style>
        /* Base Setup & Animations */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
        html { scroll-behavior: smooth; }
        body { background-color: #f4f7f6; color: #333; line-height: 1.6; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Navigation */
        nav { background: #1e293b; position: sticky; top: 0; padding: 1rem; text-align: center; z-index: 100; }
        nav a { color: #fff; text-decoration: none; margin: 0 10px; font-weight: bold; transition: color 0.3s; }
        nav a:hover { color: #38bdf8; }

        /* Main Container */
        .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }

        /* Sections & Cards */
        section { 
            background: #fff; 
            padding: 1.5rem; 
            margin-bottom: 1.5rem; 
            border-radius: 8px; 
            box-shadow: 0 2px 5px rgba(0,0,0,0.1); 
            animation: fadeIn 0.8s ease-in-out;
        }
        h2 { color: #0f172a; border-bottom: 2px solid #38bdf8; padding-bottom: 5px; margin-bottom: 1rem; }

        /* Profile Section */
        .profile { text-align: center; }
        .profile img { width: 100px; height: 100px; border-radius: 50%; margin-bottom: 0.5rem; }

        /* Skills Tags */
        .skills span { 
            display: inline-block; 
            background: #e0f2fe; 
            color: #0369a1; 
            padding: 5px 12px; 
            margin: 4px; 
            border-radius: 15px; 
            font-size: 0.9rem;
            transition: transform 0.2s;
        }
        .skills span:hover { transform: scale(1.1); }

        /* Buttons & Resume */
        .btn { 
            display: inline-block; 
            background: #38bdf8; 
            color: #fff; 
            padding: 8px 16px; 
            text-decoration: none; 
            border-radius: 5px; 
            transition: background 0.3s; 
        }
        .btn:hover { background: #0284c7; }

        /* Lists */
        ul { margin-left: 1.5rem; }
        li { margin-bottom: 0.5rem; }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav>
        <a href="#profile">Profile</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="container">
        
        <!-- Profile -->
        <section id="profile" class="profile">
            <img src="https://picsum.photos/100" alt="Profile Picture">
            <h1>Alex Morgan</h1>
            <p>Web Developer & Technology Enthusiast</p>
        </section>

        <!-- Education -->
        <section id="education">
            <h2>Educational Qualifications</h2>
            <ul>
                <li><strong>B.S. in Computer Science</strong> - State University (2020 - 2024)</li>
                <li><strong>High School Diploma</strong> - City High School (2018 - 2020)</li>
            </ul>
        </section>

        <!-- Technical Skills -->
        <section id="skills">
            <h2>Technical Skills</h2>
            <div class="skills">
                <span>HTML5</span>
                <span>CSS3</span>
                <span>JavaScript</span>
                <span>Git</span>
                <span>Python</span>
            </div>
        </section>

        <!-- Hobbies -->
        <section id="hobbies">
            <h2>Hobbies & Interests</h2>
            <ul>
                <li>Building Web Projects</li>
                <li>Digital Photography</li>
                <li>Chess & Gaming</li>
            </ul>
        </section>

        <!-- Projects -->
        <section id="projects">
            <h2>Projects</h2>
            <ul>
                <li><strong>Task Tracker App:</strong> A simple to-do app built using pure JavaScript.</li>
                <li><strong>Weather Dashboard:</strong> Displays real-time weather using a web API.</li>
            </ul>
        </section>

        <!-- Achievements -->
        <section id="achievements">
            <h2>Achievements</h2>
            <ul>
                <li>1st Place in College Hackathon (2023)</li>
                <li>Certified Web Developer - Online Academy</li>
            </ul>
        </section>

        <!-- Resume -->
        <section id="resume">
            <h2>Resume</h2>
            <p>Download my updated resume below:</p><br>
            <a href="#" class="btn">Download Resume (PDF)</a>
        </section>

        <!-- Contact Information -->
        <section id="contact">
            <h2>Contact Details</h2>
            <p><strong>Email:</strong> alex.morgan@example.com</p>
            <p><strong>Phone:</strong> +1 (555) 123-4567</p>
            <p><strong>Location:</strong> New York, USA</p>
        </section>

    </div>

</body>
</html>
